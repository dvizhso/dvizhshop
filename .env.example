# ============================================================
#  DVIZH FREIBURG SHOP — переменные окружения
#  Проще всего заполнить через мастер: npm run setup
#  (или npm run setup:cli — скрытый ввод в терминале).
#  Вручную: скопируйте файл в .env и заполните значения.
#  .env никогда не коммитится в Git.
# ============================================================

# --- Telegram admin bot -------------------------------------
# Токен отдельного бота-администратора от @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш Telegram user id (число). Узнать: напишите @userinfobot.
# Если оставить пустым — первый, кто отправит /start боту, станет администратором.
ADMIN_ID=

# --- Admin API ----------------------------------------------
# Секрет для /api/admin/*. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --- Server -------------------------------------------------
PORT=8088
HOST=0.0.0.0

# Публичный адрес сайта (кнопка «Открыть сайт» в боте)
SITE_URL=http://localhost:8088

# Каталог для базы и фото (по умолчанию ./data)
# DATA_DIR=/var/lib/dvizhshop

# 1 = бот не отправляет приветствие при запуске
QUIET_START=0
